# Copy to .env for local development. Never commit .env.

# development, staging or production
FLASK_ENV=development
# Required outside development. In development a random value is not needed.
SECRET_KEY=
# Database, in order of precedence:
# 1. Cloud SQL with IAM database auth (used on Cloud Run; no password). The IAM
#    user is the service account email without ".gserviceaccount.com".
CLOUD_SQL_INSTANCE=
DB_USER=
DB_NAME=
# 2. A Postgres URL.
DATABASE_URL=
# 3. Neither set, in development: server/app.db (SQLite).

# Apply database migrations when the server starts. Set on staging and production
# only, never on PR previews (they share the staging database). Locally, run
# `flask --app main db upgrade` yourself instead.
RUN_MIGRATIONS=

# Canvas developer key for this app. Locally, use the UC Berkeley sandbox key:
# https://ucberkeleysandbox.instructure.com/
CANVAS_SERVER_URL=https://ucberkeleysandbox.instructure.com/
CANVAS_CLIENT_ID=
CANVAS_CLIENT_SECRET=

# Optional: members of this Canvas course are staff and admin in every course.
ADMIN_OVERRIDE_CANVAS_COURSE_ID=
# Optional: shown to staff as the account to share import spreadsheets with.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Optional: enables /api/sudo/* and export_attendance_secret. Use a long random value.
API_SECRET=

# Google Sheets import uses Application Default Credentials. Locally, run:
#   gcloud auth application-default login \
#     --scopes=https://www.googleapis.com/auth/cloud-platform,https://www.googleapis.com/auth/spreadsheets.readonly
# and share the sheet with your account.
